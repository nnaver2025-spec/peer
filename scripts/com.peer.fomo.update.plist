<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peer.fomo.update</string>
    <!-- 런처는 ~/.peer-cron에 둔다. macOS TCC가 launchd/cron이 Documents 안의
         스크립트를 직접 실행하는 것을 막기 때문이다(Operation not permitted). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/huisang/.peer-cron/run_fomo.sh</string>
    </array>
    <!-- 2시간. 한 회차에 500회 넘게 요청하므로 대시보드(30분)와 분리한다. -->
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>StandardOutPath</key>
    <string>/Users/huisang/.peer-cron/fomo.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/huisang/.peer-cron/fomo.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
