<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peer.fomo.update</string>
    <!-- 런처는 ~/.peer-cron에 둔다. macOS TCC가 launchd/cron이 Documents 안의
         스크립트를 직접 실행하는 것을 막기 때문이다(Operation not permitted). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/huisang/.peer-cron/run_fomo.sh</string>
    </array>
    <!-- 2시간. 한 회차에 500회 넘게 요청하므로 대시보드(30분)와 분리한다. -->
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>StandardOutPath</key>
    <string>/Users/huisang/.peer-cron/fomo.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/huisang/.peer-cron/fomo.err.log</string>
    <!-- launchd 기본 maxfiles가 256이라 병렬 수집(소스 8개 x 지수 별칭)에서
         파일 디스크립터가 고갈된다. 실측에서 지수 소스가 `[Errno 24] Too many
         open files`로 빠져 표본이 줄었다. 로그인 셸(1048575)과 달리 launchd는
         한도를 물려받지 않으므로 여기서 올려준다. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
