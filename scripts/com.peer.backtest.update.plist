<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peer.backtest.update</string>
    <!-- 런처는 ~/.peer-cron에 둔다. macOS TCC가 launchd/cron이 Documents 안의
         스크립트를 직접 실행하는 것을 막기 때문이다(Operation not permitted). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/huisang/.peer-cron/run_backtest.sh</string>
    </array>
    <!-- 2시간. 6년치를 다시 계산하지만 확정된 과거 통계는 하루 사이에 거의
         움직이지 않는다. 바뀌는 값은 마지막 거래일 기준 현재 위치뿐이다. -->
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>StandardOutPath</key>
    <string>/Users/huisang/.peer-cron/backtest.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/huisang/.peer-cron/backtest.err.log</string>
    <!-- 32개 그룹을 병렬로 내려받는다. launchd 기본 maxfiles(256)로는 파일
         디스크립터가 모자랄 수 있어 여론 수집과 같은 값으로 올려둔다. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
